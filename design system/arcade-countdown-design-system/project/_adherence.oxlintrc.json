{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/cabinet/**",
              "components/chrome/**",
              "components/controls/**",
              "components/readout/**",
              "components/views/**",
              "explorations/**",
              "ui_kits/cabinet/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Michroma|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Michroma, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AttractScreen'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|title|subtitle|prompt|onStart|key|ref|className|style|children)$/]",
        "message": "<AttractScreen> doesn't accept that prop. Declared props: image, title, subtitle, prompt, onStart."
      },
      {
        "selector": "JSXOpeningElement[name.name='Bezel'] > JSXAttribute > JSXIdentifier[name!=/^(?:interactive|lit|ratio|children|footer|style|key|ref|className|style|children)$/]",
        "message": "<Bezel> doesn't accept that prop. Declared props: interactive, lit, ratio, children, footer, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CartridgeSlot'] > JSXAttribute > JSXIdentifier[name!=/^(?:day|state|label|still|countdown|onOpen|key|ref|className|style|children)$/]",
        "message": "<CartridgeSlot> doesn't accept that prop. Declared props: day, state, label, still, countdown, onOpen."
      },
      {
        "selector": "JSXOpeningElement[name.name='CartridgeSlot'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:cleared|ready|locked)$/]",
        "message": "<CartridgeSlot> state must be one of 'cleared' | 'ready' | 'locked'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ControlDeck'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|note|key|ref|className|style|children)$/]",
        "message": "<ControlDeck> doesn't accept that prop. Declared props: children, note."
      },
      {
        "selector": "JSXOpeningElement[name.name='CRTOverlay'] > JSXAttribute > JSXIdentifier[name!=/^(?:scanlines|vignette|flicker|key|ref|className|style|children)$/]",
        "message": "<CRTOverlay> doesn't accept that prop. Declared props: scanlines, vignette, flicker."
      },
      {
        "selector": "JSXOpeningElement[name.name='DayView'] > JSXAttribute > JSXIdentifier[name!=/^(?:day|eyebrow|title|onClose|children|key|ref|className|style|children)$/]",
        "message": "<DayView> doesn't accept that prop. Declared props: day, eyebrow, title, onClose, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlyphButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|size|children|disabled|key|ref|className|style|children)$/]",
        "message": "<GlyphButton> doesn't accept that prop. Declared props: tone, size, children, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlyphButton'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:cyan|pink)$/]",
        "message": "<GlyphButton> tone must be one of 'cyan' | 'pink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HighScoreRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|key|ref|className|style|children)$/]",
        "message": "<HighScoreRow> doesn't accept that prop. Declared props: label, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='Marquee'] > JSXAttribute > JSXIdentifier[name!=/^(?:kickerLeft|kickerRight|title|subtitle|children|key|ref|className|style|children)$/]",
        "message": "<Marquee> doesn't accept that prop. Declared props: kickerLeft, kickerRight, title, subtitle, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReelPhoto'] > JSXAttribute > JSXIdentifier[name!=/^(?:url|caption|key|ref|className|style|children)$/]",
        "message": "<ReelPhoto> doesn't accept that prop. Declared props: url, caption."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|columns|key|ref|className|style|children)$/]",
        "message": "<StatusBar> doesn't accept that prop. Declared props: children, columns."
      },
      {
        "selector": "JSXOpeningElement[name.name='Timer'] > JSXAttribute > JSXIdentifier[name!=/^(?:target|value|size|tone|segmented|key|ref|className|style|children)$/]",
        "message": "<Timer> doesn't accept that prop. Declared props: target, value, size, tone, segmented."
      },
      {
        "selector": "JSXOpeningElement[name.name='Timer'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Timer> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Timer'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:cyan|pink)$/]",
        "message": "<Timer> tone must be one of 'cyan' | 'pink'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
